# Python 环境与构建缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境 (严格本地隔离)
.venv/
venv/
ENV/
env/

# IDE 与操作系统临时文件
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 敏感信息与环境变量文件
.env
.env.local
*.local.json
secrets.yaml

# 单元测试与覆盖率
.pytest_cache/
.coverage
htmlcov/

# 本项目运行状态与产物（含候选池、正文、简报、失败留底）
state/
out/

# WorkBuddy 本地工作数据（项目记忆、会话上下文，非代码）
.workbuddy/

# 任何可能含令牌的本地覆盖配置
# （*.local.json 已在上面忽略，这里显式列出令牌文件，避免误提交）
config/settings.local.json
config/secrets.local.json
config/secrets.json
config/settings.local.json.bak
config/settings.local.json.tmp
config/blacklist.json.bak
config/blacklist.json.tmp
